rules_version = '2';

// Regras do Firestore do app ImagineUP (projeto imagine-up-app).
//
// Tudo fechado por padrão. O servidor (Admin SDK nas Cloud Functions, que não
// passa por estas regras) cria o perfil no cadastro e grava pontos, nível,
// saldo, @, foto, missões, resgates, ranking, convites, a entrada em centrais,
// o mural, a agenda e a moderação.
// O celular só lê o próprio perfil e edita o nome e a cidade; o resto chega
// pela API (função api, docs/arquitetura-api.md).
//
// A equipe do painel admin entra pelo mesmo Authentication dos fãs, mas estar
// logado nunca basta: só um staff/{uid} com status 'active' (gravado pelo
// servidor, no aceite do convite) dá acesso, e o papel e as seções saem dele.
// O storage.rules repete canEditSection('artists') para o envio das fotos e,
// desde o bloco 10, canEditSection('rewards') para a foto das recompensas:
// mudou a regra da equipe aqui, mude lá também.
//
// Mudou algo aqui? Rode `npm run test:rules` antes de publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSelf(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Doc da equipe de quem pede. Lido a cada pedido (conta como leitura): a
    // desativação corta o acesso na hora, sem esperar o token vencer.
    function staffMember() {
      return get(/databases/$(database)/documents/staff/$(request.auth.uid)).data;
    }

    function isActiveStaff() {
      return request.auth != null
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
        && staffMember().get('status', '') == 'active'
        && staffSessionAllowed();
    }

    // Conta que já existia e foi ligada à equipe (linkStaffInvite) guarda em
    // authValidAfter o auth_time do login que ligou. Sessão com login anterior
    // (de quem criou a conta com o e-mail da pessoa convidada, por exemplo)
    // não usa o acesso. Sem o campo, qualquer sessão vale.
    function staffSessionAllowed() {
      return request.auth.token.get('auth_time', 0) >= staffMember().get('authValidAfter', 0);
    }

    function isStaffAdmin() {
      return isActiveStaff() && staffMember().get('role', '') == 'admin';
    }

    // Admin vê todas as seções; editor e leitor, só as liberadas.
    function canSeeSection(section) {
      return isActiveStaff()
        && (staffMember().get('role', '') == 'admin'
          || section in staffMember().get('sections', []));
    }

    // Para as seções que o painel vai editar: admin, ou editor com a seção liberada.
    function canEditSection(section) {
      return isActiveStaff()
        && (staffMember().get('role', '') == 'admin'
          || (staffMember().get('role', '') == 'editor'
            && section in staffMember().get('sections', [])));
    }

    // Posts e shows (bloco 6): quem publica (artists, a mesma seção do
    // PANEL_CONTENT_SECTION das funções e do storage.rules), a Moderação (o post
    // do comentário denunciado) e a seção Fãs (o post e o show das curtidas e
    // presenças). É conteúdo que o app mostra a qualquer fã logado; só os
    // rascunhos ficam à vista dessas seções a mais.
    function canSeeContent() {
      return canSeeSection('artists')
        || canSeeSection('moderation')
        || canSeeSection('fans');
    }

    // Campos que o próprio fã pode editar. O @, a foto (photoURL, photoPath,
    // photoUpdatedAt) e o prazo do @ (usernameChangedAt, usernameChangeableAt)
    // são do servidor (API, bloco 9): a foto é gravada depois de validar o
    // upload, para ninguém apontar para um endereço de fora, e o @ troca junto
    // com as reservas em usernames/.
    function editableProfileFields() {
      return ['displayName', 'city', 'updatedAt'];
    }

    // O motor de regras classifica caracteres com tabelas antigas do Unicode
    // (6.0 no emulador): U+2066, U+180F e U+FFF0, por exemplo, não contam como
    // \p{C} nem \p{M} para ele e aparecem em branco no aparelho. Por isso a
    // lista explícita, junto com as letras "em branco" do Hangul e do Braille.
    function blankChars() {
      return '\\x{034F}\\x{061C}\\x{115F}\\x{1160}\\x{17B4}\\x{17B5}\\x{180E}\\x{180F}\\x{2065}-\\x{2069}\\x{2800}\\x{3164}\\x{FFA0}\\x{FFF0}-\\x{FFF8}\\x{13430}-\\x{1343F}\\x{16FE4}\\x{1BCA0}-\\x{1BCA3}\\x{1D159}\\x{E0000}-\\x{E0FFF}';
    }

    // Marcas combinantes (acentos), com os blocos que o motor não reconhece como \p{M}.
    function markChars() {
      return '\\p{M}\\x{0300}-\\x{036F}\\x{1AB0}-\\x{1AFF}\\x{1DC0}-\\x{1DFF}\\x{20D0}-\\x{20FF}\\x{FE20}-\\x{FE2F}';
    }

    // Uma linha de texto visível: não começa por acento solto, não tem espaço
    // nas pontas, nem controle, quebra de linha ou caractere em branco no meio,
    // nem mais de 3 acentos seguidos (texto "zalgo" invade as linhas vizinhas;
    // nome vietnamita decomposto usa 2). O ZWJ (U+200D) só passa entre emoji,
    // como na cantora ou no coração em chamas.
    function visibleLine(s) {
      return s.matches('^[^\\s\\p{Z}\\p{C}' + markChars() + '](([^\\p{C}\\p{Zl}\\p{Zp}]|\\x{200D})*[^\\s\\p{Z}\\p{C}])?$')
        && !s.matches('.*[' + blankChars() + '].*')
        && !s.matches('.*[' + markChars() + ']{4,}.*')
        && !s.matches('.*([^\\p{So}\\p{Sk}\\x{FE0F}\\x{1F000}-\\x{1FAFF}]\\x{200D}|\\x{200D}[^\\p{So}\\x{2190}-\\x{21FF}\\x{1F000}-\\x{1FAFF}]).*');
    }

    // Nome visível no ranking e nos comentários: 1 a 60 caracteres, numa linha visível.
    function validDisplayName(data) {
      return data.get('displayName', null) is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 60
        && visibleLine(data.displayName);
    }

    // Cidade é opcional: null limpa o campo. Texto vazio não vale.
    function validCity(data) {
      return data.get('city', null) == null
        || (data.city is string
          && data.city.size() >= 1
          && data.city.size() <= 80
          && visibleLine(data.city));
    }

    // Só os campos que mudaram são validados, para um valor gravado pelo servidor
    // em outro campo não travar a edição. updatedAt é obrigatório, vem do
    // servidor (serverTimestamp) e segura a edição a no máximo uma a cada 10 s.
    // É o carimbo de edição do fã: o servidor não grava esse campo. Se gravar
    // algo que não é data, a trava pula uma vez em vez de bloquear para sempre.
    function validProfileUpdate(changed) {
      return changed.hasOnly(editableProfileFields())
        && request.resource.data.updatedAt == request.time
        && (!(resource.data.get('updatedAt', null) is timestamp)
          || request.time > resource.data.updatedAt + duration.value(10, 's'))
        && (!('displayName' in changed) || validDisplayName(request.resource.data))
        && (!('city' in changed) || validCity(request.resource.data));
    }

    // O @, a foto e o prazo do @ são do servidor (API, bloco 9); o orçamento da
    // fila das cópias do perfil (users/{uid}/profileSync) também, e fica fechado
    // pelo match /{document=**} do fim, para o fã e para a equipe.
    //
    // Desde o bloco 11 (docs/arquitetura-api.md, 26.10), a equipe com a seção
    // fans lê e lista os perfis (a lista, a busca e a ficha da seção Fãs), e a
    // com moderation lê qualquer perfil (o autor de um comentário) e lista só
    // os suspensos (a consulta precisa de where('suspendedAt', '!=', null)).
    // A suspensão (suspendedAt, suspensionReason) e as chaves da busca
    // (searchKeys) são do servidor; o fã suspenso não edita nome nem cidade.
    match /users/{uid} {
      allow get: if isSelf(uid) || canSeeSection('fans') || canSeeSection('moderation');
      allow list: if canSeeSection('fans')
        || (canSeeSection('moderation') && resource.data.get('suspendedAt', null) != null);

      // O perfil nasce no servidor, no cadastro (com createdAt, @ e pontos).
      // Assim não há corrida com o servidor nem perfil recriado por um token
      // ainda válido depois de a conta ser excluída.
      allow create: if false;

      allow update: if isSelf(uid)
        && resource.data.get('suspendedAt', null) == null
        && validProfileUpdate(request.resource.data.diff(resource.data).affectedKeys());

      // Excluir a conta apaga o perfil e os pontos e cancela os resgates
      // abertos: é o servidor.
      allow delete: if false;

      // Vínculo do fã com as centrais: só o servidor grava (API). O fã não lê
      // nem o próprio: chega pela API (/me/centrals, isMember). A equipe com a
      // seção fans lê (seção Fãs do painel).
      match /centrals/{artistId} {
        allow read: if canSeeSection('fans');
        allow write: if false;
      }

      // Curtidas e presenças do fã (bloco 6): só o servidor grava (API). O fã
      // não lê nem as próprias: chegam pela API (likedByMe, /me/rsvps). A
      // equipe com a seção fans lê (seção Fãs do painel).
      match /postLikes/{postId} {
        allow read: if canSeeSection('fans');
        allow write: if false;
      }

      match /eventRsvps/{eventId} {
        allow read: if canSeeSection('fans');
        allow write: if false;
      }
    }

    // Pelos grupos de coleção (quem vai a um show, na seção Fãs). Valem para
    // qualquer coleção com estes nomes, em qualquer profundidade: nenhuma outra
    // pode se chamar assim.
    match /{path=**}/postLikes/{postId} {
      allow read: if canSeeSection('fans');
    }

    match /{path=**}/eventRsvps/{eventId} {
      allow read: if canSeeSection('fans');
    }

    // Os fãs de uma central, pelo grupo de coleção (seção Fãs do painel).
    // Vale para qualquer caminho que termine em centrals/{id}, inclusive uma
    // coleção de raiz: nenhuma outra coleção pode se chamar centrals.
    match /{path=**}/centrals/{artistId} {
      allow read: if canSeeSection('fans');
    }

    // Equipe do painel. Convites, aceite e mudanças de acesso passam pelas
    // Cloud Functions (Admin SDK); pelo cliente, ninguém grava, nem admin.
    match /staff/{uid} {
      // O próprio membro lê o seu em qualquer status: o painel mostra
      // "acesso desativado" em vez de uma tela vazia. Quem tem a seção audit
      // lê e lista a equipe, para o filtro por pessoa dos Logs (bloco 11).
      allow get: if isSelf(uid) || isStaffAdmin() || canSeeSection('audit');
      allow list: if isStaffAdmin() || canSeeSection('audit');
      allow write: if false;
    }

    match /staffInvites/{inviteId} {
      allow read: if isStaffAdmin();
      allow write: if false;
    }

    match /staffAudit/{entryId} {
      allow read: if canSeeSection('audit');
      allow write: if false;
    }

    // Centrais dos artistas (o id é o @). O painel cria, edita, publica e
    // ordena pelas Cloud Functions; pelo cliente, ninguém grava. A equipe com
    // a seção artists lê todas; a equipe ativa sem ela lê só as publicadas (o
    // painel mostra o nome das centrais nas outras seções, e a consulta
    // precisa de where('status', '==', 'published')). O fã lia as publicadas
    // direto até a proteção contra abuso (docs/arquitetura-api.md, 27.6): o
    // app lê pela API desde o bloco 4, e a leitura direta só servia para
    // alguém de fora gastar leituras do projeto. Mesmo assim, aqui só fica o
    // que o app pode mostrar.
    match /artists/{artistId} {
      allow get, list: if canSeeSection('artists')
        || (isActiveStaff() && resource.data.status == 'published');
      allow write: if false;
    }

    // O que é só da equipe em cada central (contato, gestor, autorização de
    // uso de imagem, quem criou e quem editou): só a equipe com a seção artists.
    match /artistPrivate/{artistId} {
      allow read: if canSeeSection('artists');
      allow write: if false;
    }

    // Carteira, extrato e pontos por central: só o servidor grava (award, na
    // API). O fã lê pela API, nunca direto, nem a própria. A equipe com a
    // seção fans lê (seção Fãs do painel).
    match /wallets/{uid} {
      allow read: if canSeeSection('fans');
      allow write: if false;

      match /ledger/{entryId} {
        allow read: if canSeeSection('fans');
        allow write: if false;
      }

      match /centralPoints/{artistId} {
        allow read: if canSeeSection('fans');
        allow write: if false;
      }
    }

    // Valores, limites, régua e temporada. A equipe ativa lê só estes dois
    // documentos; muda só por callable, com auditoria. O app recebe os
    // valores pela API. Documento novo em config/ não fica legível sozinho.
    match /config/{docId} {
      allow read: if isActiveStaff() && docId in ['points', 'season'];
      allow write: if false;

      match /versions/{version} {
        allow read: if isActiveStaff() && docId in ['points', 'season'];
        allow write: if false;
      }
    }

    // Catálogo de missões, meta da temporada, missões arquivadas e catálogo de
    // conquistas (bloco 7). A seção missions lê tudo; a Visão geral lê o
    // catálogo e o arquivo das missões, pelos títulos das conclusões; a seção
    // Fãs lê os catálogos de agora e o arquivo (não as versões), para dar nome
    // aos ids do progresso e das conquistas na carteira de um fã. Nenhum deles
    // guarda dado de fã. Muda só por callable, com auditoria. O app recebe
    // tudo pela API.
    match /config/missions {
      allow read: if canSeeSection('missions') || canSeeSection('overview')
        || canSeeSection('fans');
      allow write: if false;

      match /versions/{version} {
        allow read: if canSeeSection('missions') || canSeeSection('overview');
        allow write: if false;
      }
    }

    match /missionArchive/{missionId} {
      allow read: if canSeeSection('missions') || canSeeSection('overview')
        || canSeeSection('fans');
      allow write: if false;
    }

    // A Visão geral também lê o catálogo de agora (bloco 11): dá nome às
    // conquistas desbloqueadas no período.
    match /config/achievements {
      allow read: if canSeeSection('missions') || canSeeSection('fans')
        || canSeeSection('overview');
      allow write: if false;

      match /versions/{version} {
        allow read: if canSeeSection('missions');
        allow write: if false;
      }
    }

    // Contadores agregados do painel (Visão geral, Crescimento, desde o
    // bloco 7 as conclusões por missão e por dia da seção Missões e, desde o
    // bloco 10, os pedidos por recompensa da seção Recompensas e resgates),
    // lidos direto com getDocs, nunca com escuta em tempo real
    // (docs/arquitetura-api.md).
    match /statsDaily/{day} {
      allow read: if canSeeSection('overview') || canSeeSection('growth')
        || canSeeSection('missions') || canSeeSection('rewards');
      allow write: if false;

      match /statsShards/{shard} {
        allow read: if canSeeSection('overview') || canSeeSection('growth')
          || canSeeSection('missions') || canSeeSection('rewards');
        allow write: if false;
      }
    }

    // Contagem de fãs de cada central, em shards. Só o servidor lê e grava.
    // O número que o app e o painel mostram é o fanCount de artists/{id},
    // copiado daqui pela fila syncArtistFanCount.
    match /artistStats/{artistId} {
      allow read, write: if false;

      match /fanShards/{shard} {
        allow read, write: if false;
      }
    }

    // Controle do fechamento do dia (bloco 11, 26.3): só o servidor grava; as
    // telas de números leem statsMeta/close para saber até onde o fechamento
    // chegou. Outro documento de statsMeta fica fechado.
    match /statsMeta/{docId} {
      allow read: if docId == 'close'
        && (canSeeSection('overview') || canSeeSection('growth')
          || canSeeSection('missions') || canSeeSection('rewards'));
      allow write: if false;
    }

    // Chaves de idempotência da API: só o servidor. O orçamento do dia da
    // equipe (staffLimits, bloco 11) também é só do servidor e não tem regra
    // própria: o match /{document=**} do fim fecha.
    match /idempotency/{id} {
      allow read, write: if false;
    }

    // Convite (bloco 5): o código de cada fã, os links que ele compartilhou e
    // quem trouxe quem, com a origem. Só o servidor grava (API). O fã não lê
    // nada disso direto, nem o próprio: chega pela API (/me/invite e
    // /me/progress). A equipe com a seção fans lê (seção Fãs do painel).
    // O dono de um código, pela equipe, é fanInvites com where('code', '==', ...):
    // inviteCodes guarda o ownerKey, que não sai do servidor.
    match /inviteCodes/{code} {
      allow read, write: if false;
    }

    match /fanInvites/{uid} {
      allow read: if canSeeSection('fans');
      allow write: if false;

      match /inviteLinks/{linkId} {
        allow read: if canSeeSection('fans');
        allow write: if false;
      }

      // Quem já contou como visitante (o id é a chave da pessoa): só o servidor.
      match /inviteVisitors/{personKey} {
        allow read, write: if false;
      }
    }

    match /referrals/{uid} {
      allow read: if canSeeSection('fans');
      allow write: if false;
    }

    // Mural (bloco 6): a equipe publica pelas callables, com a seção artists.
    // O fã lê tudo pela API, nunca direto, nem os posts no ar. Desde o bloco
    // 11, a seção missions também lê (escolhe e mostra o post alvo de uma
    // missão).
    match /posts/{postId} {
      allow read: if canSeeContent() || canSeeSection('missions');
      allow write: if false;

      // Comentários: a equipe que cuida do conteúdo, a da Moderação e, desde
      // o bloco 11, a seção fans (os comentários de um fã, na ficha).
      match /postComments/{commentId} {
        allow read: if canSeeSection('artists') || canSeeSection('moderation')
          || canSeeSection('fans');
        allow write: if false;
      }
    }

    match /{path=**}/postComments/{commentId} {
      allow read: if canSeeSection('artists') || canSeeSection('moderation')
        || canSeeSection('fans');
    }

    // Contagens dos posts em shards: só o servidor. O número que o app mostra
    // é a cópia em posts/{id}, gravada pela fila syncPostCounts.
    match /postStats/{postId} {
      allow read, write: if false;

      match /countShards/{shard} {
        allow read, write: if false;
      }
    }

    // Agenda (bloco 6): os shows, pelas callables, com a seção artists. A
    // seção rewards também lê (bloco 10): escolhe o show da recompensa e
    // mostra o nome dele; e, desde o bloco 11, a seção missions (o show alvo
    // de uma missão). O show não guarda dado que elas não devam ver.
    match /events/{eventId} {
      allow read: if canSeeContent() || canSeeSection('rewards')
        || canSeeSection('missions');
      allow write: if false;
    }

    // Moderação (bloco 6, provisória até a UP-48): as denúncias e a fila.
    // Desde o bloco 11, as denúncias uma a uma ficam só do servidor, até para
    // a Moderação: guardam quem denunciou (reporterUid), e com o perfil
    // liberado a equipe ligaria o uid ao nome. A tela usa os itens da fila
    // (moderationQueue), com a contagem por motivo e as datas.
    match /commentReports/{reportId} {
      allow read, write: if false;
    }

    match /moderationQueue/{commentId} {
      allow read: if canSeeSection('moderation');
      allow write: if false;
    }

    // Listas de bloqueio: dizem quem bloqueou quem, e nenhuma tela do painel
    // as usa. Só o servidor (API e exclusão de conta). Repete o fechado do
    // match final de propósito, como o postStats.
    match /blockLists/{uid} {
      allow read, write: if false;
    }

    // Resultado congelado das temporadas (bloco 8): o cabeçalho e a posição
    // final de cada fã que pontuou, com o nome, a foto e a cidade da virada.
    // Só o servidor grava (a virada e a exclusão de conta). A seção ranking
    // lê (Ranking e temporadas). O fã não lê: o app recebe a temporada e o
    // ranking pela API.
    match /seasons/{seasonId} {
      allow read: if canSeeSection('ranking');
      allow write: if false;

      match /standings/{uid} {
        allow read: if canSeeSection('ranking');
        allow write: if false;
      }
    }

    // Andamento da virada e do retrato semanal: só o servidor.
    match /rankingJobs/{jobId} {
      allow read, write: if false;
    }

    // Loja (bloco 10): o catálogo de recompensas e os pedidos de resgate. Só
    // o servidor grava (callables do painel, API e exclusão de conta). O fã
    // não lê nada disso direto, nem os próprios pedidos: chega pela API
    // (GET /rewards). A seção rewards lê (Recompensas e resgates). O pedido
    // guarda a cópia do nome e do @ do fã; o e-mail não mora aqui (callable
    // getRedemptionContacts, docs/arquitetura-api.md, 25.8).
    match /rewards/{rewardId} {
      allow read: if canSeeSection('rewards');
      allow write: if false;
    }

    match /redemptions/{redemptionId} {
      allow read: if canSeeSection('rewards');
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
