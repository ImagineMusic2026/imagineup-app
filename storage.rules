rules_version = '2';

// Regras do Cloud Storage do app ImagineUP (bucket imagine-up-app.firebasestorage.app).
//
// Tudo fechado por padrão. Desde o bloco 6, a mídia dos posts do mural e a
// foto dos shows da agenda seguem o mesmo molde, em posts/{postId}/ e
// events/{eventId}/. As fotos das centrais sobem do painel admin direto
// para artists/{artistId}/, com um nome novo a cada envio; a Cloud Function
// confere o arquivo e grava a URL em artists/{artistId}. Qualquer um baixa uma
// foto pelo caminho exato (o app mostra a URL), ninguém lista a pasta, e só o
// servidor apaga ou troca arquivos.
//
// Desde o bloco 9, a foto do fã sobe do app para fans/{uid}/, só do próprio
// fã, só JPEG de até 1 MiB, com o nome que o app gera e só com o perfil
// existindo; a função api confere o arquivo e grava a URL no perfil.
//
// Desde o bloco 10, a foto das recompensas da loja sobe do painel para
// rewards/{rewardId}/, de quem altera Recompensas e resgates
// (canEditSection('rewards')), só para uma recompensa que já existe, no
// molde da foto dos shows; a callable updateReward confere o arquivo.
//
// Desde o fã-clube gerido pelo fã (seção 34 de docs/arquitetura-api.md,
// 34.6), a foto e a miniatura das publicações sobem do app para
// fanClubMedia/{uid}/, só do próprio gestor, só JPEG de até 2 MiB, com os
// nomes da vaga que a API abriu; a função api confere os arquivos e grava as
// URLs na publicação, que a equipe revisa antes de ir ao ar.
//
// Quem sobe é quem altera Artistas e centrais no painel: a mesma conta de
// canEditSection('artists') e staffSessionAllowed() do firestore.rules, lendo
// staff/{uid} no Firestore. E só para uma central que já existe em
// artists/{artistId} (o painel cria a central antes de subir a foto): foto de
// central já apagada, ou de um @ que ainda não é central, é recusada e não
// fica largada no bucket. Cada envio lê staff/{uid} e artists/{artistId} no Firestore (conta
// como leitura, só no envio). Mudou a regra da equipe lá? Mude aqui também,
// com teste nos dois.
//
// Mudou algo aqui? Rode `npm run test:rules` antes de publicar.
service firebase.storage {
  match /b/{bucket}/o {

    function staffPath() {
      return /databases/(default)/documents/staff/$(request.auth.uid);
    }

    function staffMember() {
      return firestore.get(staffPath()).data;
    }

    // Admin, ou editor com a seção liberada, ativo e com sessão de login a
    // partir do authValidAfter (conta que já existia e foi ligada à equipe).
    function canEditSection(section) {
      return request.auth != null
        && firestore.exists(staffPath())
        && staffMember().get('status', '') == 'active'
        && request.auth.token.get('auth_time', 0) >= staffMember().get('authValidAfter', 0)
        && (staffMember().get('role', '') == 'admin'
          || (staffMember().get('role', '') == 'editor'
            && section in staffMember().get('sections', [])));
    }

    // Foto já redimensionada pelo painel: webp, jpeg ou png, de 1 byte a 5 MB.
    function validImage() {
      return request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(webp|jpeg|png)');
    }

    // Vídeo dos posts de vídeo (bloco 6): mp4 de 1 byte a 50 MB.
    function validVideo() {
      return request.resource.size > 0
        && request.resource.size <= 50 * 1024 * 1024
        && request.resource.contentType == 'video/mp4';
    }

    function docExists(collection, id) {
      return firestore.exists(/databases/(default)/documents/$(collection)/$(id));
    }

    // O perfil do fã existe e não está suspenso (bloco 11, docs/arquitetura-api.md,
    // 26.6): conta só da equipe, conta já excluída e fã suspenso não sobem foto.
    // O get de um perfil que não existe dá erro, e erro nega.
    function fanCanUpload(uid) {
      let profile = firestore.get(/databases/(default)/documents/users/$(uid));
      return profile != null && profile.data.get('suspendedAt', null) == null;
    }

    // A vaga de envio (proteção contra abuso, docs/arquitetura-api.md, 27.4):
    // o servidor grava users/{uid}/uploads/photo pelo POST /me/photo/upload,
    // com o nome do arquivo e o prazo, e conta cada arquivo novo no teto do
    // dia. A regra não conta envios; sem a vaga, um fã subiria arquivos sem
    // parar. Com o fanCanUpload, são as duas leituras do Firestore que o
    // Storage aceita por avaliação.
    function photoUploadReserved(uid, fileName) {
      let slot = firestore.get(/databases/(default)/documents/users/$(uid)/uploads/photo);
      return slot != null
        && slot.data.fileName == fileName
        && request.time < slot.data.expiresAt;
    }

    // A vaga de envio da foto da publicação do fã-clube (seção 34, 34.6): o
    // servidor grava users/{uid}/uploads/fanClubPost pelo
    // POST /me/fan-club/upload, com os dois nomes (a foto e a miniatura) e o
    // prazo, e só para o gestor de fã-clube ativo de artista com as fotos de
    // fã ligadas: a regra não comporta uma terceira leitura. Com o
    // fanCanUpload, são as duas leituras do Firestore por avaliação.
    function fanClubUploadReserved(uid, fileName) {
      let slot = firestore.get(/databases/(default)/documents/users/$(uid)/uploads/fanClubPost);
      return slot != null
        && fileName in slot.data.fileNames
        && request.time < slot.data.expiresAt;
    }

    function artistExists(artistId) {
      return docExists('artists', artistId);
    }

    // O tipo do post decide o que entra: foto, só imagem; vídeo, imagem (a
    // capa e a miniatura) ou mp4; texto e show, nada. O get de um post que não
    // existe dá erro, e erro nega: vale como a conferência de existência, com
    // a mesma leitura.
    function postAcceptsFile(postId) {
      let kind = firestore.get(/databases/(default)/documents/posts/$(postId)).data.get('kind', '');
      return (kind == 'photo' && validImage())
        || (kind == 'video' && (validImage() || validVideo()));
    }

    match /artists/{artistId}/{fileName} {
      allow get: if true;
      allow list: if false;
      // Nome novo a cada envio (resource == null): um arquivo nunca é trocado
      // por cima, porque os aparelhos guardam a foto de uma URL para sempre.
      // O @ no formato das centrais, fora dos ids que o Firestore reserva
      // (__.*__), e a central já criada.
      allow create: if resource == null
        && artistId.matches('[a-z0-9_]{3,30}')
        && !artistId.matches('__.*__')
        && validImage()
        && canEditSection('artists')
        && artistExists(artistId);
      // Metadados e exclusão: só o servidor (Admin SDK), que apaga a pasta de
      // uma central apagada e as versões antigas depois de trocar ou tirar a
      // foto.
      allow update, delete: if false;
    }

    // Mídia dos posts do mural (bloco 6): foto, miniatura, capa do vídeo e o
    // mp4, do painel, de quem edita artists (a seção que publica no mural,
    // provisória até a UP-9), só para um post que já existe. Nome novo a cada
    // envio; só o servidor troca metadados e apaga.
    match /posts/{postId}/{fileName} {
      allow get: if true;
      allow list: if false;
      allow create: if resource == null
        && postId.matches('[A-Za-z0-9_-]{1,128}')
        && !postId.matches('__.*__')
        && canEditSection('artists')
        && postAcceptsFile(postId);
      allow update, delete: if false;
    }

    // Foto dos shows da agenda (bloco 6), só para um show que já existe.
    match /events/{eventId}/{fileName} {
      allow get: if true;
      allow list: if false;
      allow create: if resource == null
        && eventId.matches('[A-Za-z0-9_-]{1,128}')
        && !eventId.matches('__.*__')
        && validImage()
        && canEditSection('artists')
        && docExists('events', eventId);
      allow update, delete: if false;
    }

    // Foto do fã (bloco 9): o próprio fã sobe para a pasta dele um JPEG de até
    // 1 MiB, com o nome que o app gera (photo-<id>.jpg), sem sobrescrever, e só
    // com o perfil existindo e sem suspensão: conta só da equipe, conta já
    // excluída (o token ainda vale até 1 h) e, desde o bloco 11, o fã suspenso
    // não sobem. Desde a proteção contra abuso, só o arquivo da vaga aberta
    // pela API e antes do prazo dela (photoUploadReserved, acima). A função
    // api confere o arquivo e grava a URL no perfil; os
    // outros fãs veem a foto pela URL com token. O dono lê
    // pelo caminho: o app confere os metadados, antes de enviar de novo, para
    // saber se o envio de uma tentativa já chegou. Só o servidor apaga (a foto
    // trocada, os envios que não viraram a foto e a pasta da conta excluída).
    match /fans/{uid}/{fileName} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list: if false;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && resource == null
        && uid.matches('[A-Za-z0-9]{1,128}')
        && fileName.matches('photo-[a-z0-9-]{8,40}[.]jpg')
        && request.resource.size > 0
        && request.resource.size <= 1024 * 1024
        && request.resource.contentType == 'image/jpeg'
        && fanCanUpload(uid)
        && photoUploadReserved(uid, fileName);
      allow update, delete: if false;
    }

    // Fotos das publicações do fã-clube (seção 34, 34.6): o gestor sobe para a
    // pasta dele a foto e a miniatura (club-photo-<id>.jpg e
    // club-thumb-<id>.jpg), JPEG de até 2 MiB, sem sobrescrever, só com o
    // perfil existindo e sem suspensão, e só os nomes da vaga aberta pela API,
    // antes do prazo dela. A pasta fica fora de fans/{uid}/, que a varredura
    // da foto do perfil esvazia. A função api confere os bytes (a miniatura
    // até 300 KiB) e grava as URLs com token; o dono lê pelo caminho (o app
    // confere se o envio de uma tentativa já chegou). Só o servidor apaga (a
    // publicação retirada ou recusada, a vaga trocada e a pasta da conta
    // excluída) e troca o token (a publicação oculta ou tirada do ar).
    match /fanClubMedia/{uid}/{fileName} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list: if false;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && resource == null
        && uid.matches('[A-Za-z0-9]{1,128}')
        && fileName.matches('club-(photo|thumb)-[a-z0-9-]{8,40}[.]jpg')
        && request.resource.size > 0
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg'
        && fanCanUpload(uid)
        && fanClubUploadReserved(uid, fileName);
      allow update, delete: if false;
    }

    // Foto das recompensas da loja (bloco 10): do painel, de quem edita
    // rewards, só para uma recompensa que já existe. Nome novo a cada envio;
    // só o servidor troca metadados e apaga (a foto trocada e a pasta da
    // recompensa apagada).
    match /rewards/{rewardId}/{fileName} {
      allow get: if true;
      allow list: if false;
      allow create: if resource == null
        && rewardId.matches('[A-Za-z0-9_-]{1,128}')
        && !rewardId.matches('__.*__')
        && validImage()
        && canEditSection('rewards')
        && docExists('rewards', rewardId);
      allow update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
