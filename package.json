{
  "name": "imagineup-app",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:go": "expo start --go",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "expo lint",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests",
    "test": "jest",
    "doctor": "npx expo-doctor",
    "check": "npm run typecheck && npm run lint && npm test",
    "build:dev:android": "eas build --profile development --platform android",
    "build:dev:ios-sim": "eas build --profile development-simulator --platform ios",
    "build:preview:android": "eas build --profile preview --platform android",
    "update:preview": "eas update --channel preview --environment preview",
    "update:production": "eas update --channel production --environment production",
    "test:rules": "npx --yes firebase-tools@15.32.0 emulators:exec --only firestore,storage --project imagine-up-app \"jest -c jest.rules.config.js\"",
    "test:functions": "node scripts/functions-emulator-env.mjs && npm --prefix functions run build && npx --yes cross-env@10.1.0 FUNCTIONS_DISCOVERY_TIMEOUT=60 npx --yes firebase-tools@15.32.0 emulators:exec --only auth,firestore,functions,storage --project demo-imagine-up-app \"npm --prefix functions run test:emulator\"",
    "rules:deploy": "npx --yes firebase-tools@15.32.0 deploy --only firestore:rules,firestore:indexes,storage --project imagine-up-app",
    "emulators": "node scripts/emulators.mjs",
    "emulators:seed": "node scripts/seed-emulators.mjs",
    "functions:deploy": "npx --yes firebase-tools@15.32.0 deploy --only functions --project imagine-up-app"
  },
  "dependencies": {
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo-google-fonts/sora": "^0.4.2",
    "@hookform/resolvers": "^5.9.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@shopify/flash-list": "2.0.2",
    "@shopify/react-native-skia": "2.6.2",
    "@tanstack/query-async-storage-persister": "^5.104.0",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-query-persist-client": "^5.104.0",
    "axios": "^1.20.0",
    "date-fns": "^4.4.0",
    "expo": "~57.0.25",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.23",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.23",
    "expo-web-browser": "~57.0.3",
    "firebase": "^12.19.0",
    "lucide-react-native": "^1.48.0",
    "react": "19.2.3",
    "react-hook-form": "^7.89.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.4",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.5",
    "prettier": "^3.9.9",
    "react-test-renderer": "^19.2.3",
    "typescript": "~6.0.3"
  }
}
