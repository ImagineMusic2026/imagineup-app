# Parâmetros das Cloud Functions (defineString). Aqui só os nomes: os valores
# nunca entram no git.
#
# Projeto de verdade: copie para functions/.env.imagine-up-app e preencha.
# Emuladores: functions/.env.demo-imagine-up-app (o npm run test:functions e o
# npm run emulators criam com o EmailJS vazio, e o convite sai sem e-mail).
#
# A chave privada do EmailJS é secret, não parâmetro:
#   projeto: npx --yes firebase-tools@15.32.0 functions:secrets:set EMAILJS_PRIVATE_KEY --project imagine-up-app
#   emuladores: EMAILJS_PRIVATE_KEY=... em functions/.secret.local
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
PANEL_URL=
