# Copie para .env e preencha. O .env não vai para o git.
# Valores EXPO_PUBLIC_* entram no bundle do app: nada secreto aqui.
# Nas builds da EAS, os mesmos nomes ficam em Environment variables do projeto
# no expo.dev (development, preview e production).

# Firebase, projeto imagine-up-app (só do app). Console > Configurações do projeto > Seus apps > app da Web.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=imagine-up-app.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=imagine-up-app
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Endereço da função api (Cloud Functions). Fica vazio até todas as ações que
# rendem ou gastam pontos estarem na API (depois do bloco 10): preenchido antes,
# toda ação de exemplo rende 0, todo resgate recusa e todo fã fica com 0 ponto e
# nível 1 (docs/arquitetura-api.md, seção 13). Com o emulador abaixo preenchido,
# este valor é ignorado.
EXPO_PUBLIC_API_URL=

# Emuladores do Firebase (npm run emulators), só em desenvolvimento. Vazio usa o
# projeto real. Emulador Android: 10.0.2.2 (o computador visto de dentro dele).
# Preenchido, a carteira e o progresso vêm da função api do emulador de
# Functions (porta 5001 deste host), e o resto segue nos dados de exemplo.
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=
